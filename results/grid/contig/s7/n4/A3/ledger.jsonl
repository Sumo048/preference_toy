{"kind": "tool", "run": "grid_cond_contig_s7_n4_A3", "ts": "2026-11-04T15:16:30+00:00", "session": "s004", "version": "v3", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 366, "wall_s": 88.37, "decodes": 35000.0, "code_sha256": "72c5217f0f2ab85b898cdbfbacc7909d615864f680cd6cf5bef7d7c7c50f69f5", "code": "import numpy as np, torch, model\nnet = model.load()\nw=torch.tensor(np.load('contrast_c3_blocks.1.act_k10.npy')).float().reshape(-1); b=-2.6697\ntorch.manual_seed(2)\nN=3000\ncs=[0.1,0.3,0.5,0.7,0.9]\nwith torch.no_grad():\n    def run(xi,c,dv,K0,K):\n        x=xi.clone(); n=len(x)\n        for k in range(20):\n            t=torch.full((n,),1-k/20)\n            v,A=net.velocity(x,t,c,(\"blocks.1.act\",),count=False)\n            if K0<=k<K:\n                f=(A[\"blocks.1.act\"]@w+b>0)\n                v=v+f.float().reshape(-1,1)*torch.tensor(dv).float()\n            x=x-v/20\n        return x\n    res={}\n    data=[]\n    for c0 in cs:\n        c=torch.full((N,),c0)\n        pool=model.decode(net,torch.randn(4000,2),torch.full((4000,),c0))\n        xi=torch.randn(N,2)\n        a0=model.decode(net,xi,c)\n        data.append((c,xi,a0,pool))\n    def score(dv,K0,K):\n        offs=[];base=[];up=[]\n        for c,xi,a0,pool in data:\n            a=run(xi,c,dv,K0,K)\n            d=torch.cdist(a,pool).min(1).values; d0=torch.cdist(a0,pool).min(1).values\n            offs.append((d>0.12).float().mean().item()); base.append((d0>0.12).float().mean().item())\n            up.append((a[:,1]>0.3).float().mean().item())\n        return np.mean(offs)-np.mean(base), np.mean(up)\n    for dv,K0,K in [((0,8),0,11),((0,8),0,6),((0,12),0,4),((0,16),0,3),((0,20),0,2),((0,6),0,8),((0,12),0,6),((0,30),0,1)]:\n        print(dv,K0,K,'between rise %.3f upper %.3f'%score(dv,K0,K))\n"}}
{"kind": "tool", "run": "grid_cond_contig_s7_n4_A3", "ts": "2026-11-04T15:19:14+00:00", "session": "s004", "version": "v3", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 534, "wall_s": 151.936, "decodes": 42000.0, "code_sha256": "a0dd44d08bb924c122316b4f7621c418281ea2d3360e7c346de3ab9da2ef57df", "code": "import numpy as np, torch, model\nnet = model.load()\nw=torch.tensor(np.load('contrast_c3_blocks.1.act_k10.npy')).float().reshape(-1); b=-2.6697\ntorch.manual_seed(3)\nN=3000\ncs=[0.05,0.25,0.45,0.65,0.85,0.97]\nwith torch.no_grad():\n    def run(xi,c,dv,K0,K):\n        x=xi.clone(); n=len(x)\n        for k in range(20):\n            t=torch.full((n,),1-k/20)\n            v,A=net.velocity(x,t,c,(\"blocks.1.act\",),count=False)\n            if K0<=k<K:\n                f=(A[\"blocks.1.act\"]@w+b>0)\n                v=v+f.float().reshape(-1,1)*torch.tensor(dv).float()\n            x=x-v/20\n        return x\n    data=[]\n    for c0 in cs:\n        c=torch.full((N,),c0)\n        pool=model.decode(net,torch.randn(4000,2),torch.full((4000,),c0))\n        xi=torch.randn(N,2); a0=model.decode(net,xi,c)\n        d0=torch.cdist(a0,pool).min(1).values\n        data.append((c,xi,a0,pool,d0))\n    for dv,K0,K in [((0,8),0,11),((0,20),0,2),((0,16),0,3),((0,24),0,2),((0,12),0,6)]:\n        out=[]\n        for th in [0.05,0.08,0.2]:\n            r=[];up=[]\n            for c,xi,a0,pool,d0 in data:\n                a=run(xi,c,dv,K0,K); d=torch.cdist(a,pool).min(1).values\n                r.append(((d>th).float().mean()-(d0>th).float().mean()).item()); up.append((a[:,1]>0.3).float().mean().item())\n            out.append('th%.2f %.4f(max %.4f)'%(th,np.mean(r),np.max(r)))\n        print(dv,K0,K,' '.join(out),'upper %.3f'%np.mean(up))\n"}}
