{"kind": "tool", "run": "grid_cond_contig_s7_n4_A3", "ts": "2026-11-04T15:04:15+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 3472, "wall_s": 7.331, "decodes": 0.0, "code_sha256": "0dc45489a04b23317d838a55ac2523184b0ab2761e3b7a9bae0846f011688c26", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nw=torch.tensor(np.load('contrast_c2_blocks.1_k8.npy')); b=-0.1860\nprint(neg['uid'], neg['c'], neg['a'])\nimport inspect; print(inspect.signature(net.velocity))\ndef dec(xi,c,delta,klo=0,khi=9):\n    x=torch.tensor(xi).float(); c=torch.tensor(c).float()\n    fired=torch.zeros(len(x),dtype=torch.bool)\n    for k in range(20):\n        t=torch.full((len(x),),1-k/20)\n        v,a=net.velocity(x,t,c,(\"blocks.1\",),count=False)\n        if klo<=k<khi and delta is not None:\n            f=(a[\"blocks.1\"]@w+b)>0; fired|=f\n            v=v+f[:,None].float()*torch.tensor(delta).float()\n        x=x-v/20\n    return x.numpy(),fired.numpy()\nrng=np.random.default_rng(0)\nN=256\nfor i in range(len(neg['uid'])):\n    ci=neg['c'][i]; xi=rng.standard_normal((N,2)).astype(np.float32)\n    a0,f0=dec(xi,np.full(N,ci),None)\n    _,f=dec(xi,np.full(N,ci),[0,0])\n    ib=model.in_basin(i,torch.tensor(a0)); ib=np.asarray(ib)\n    print(i,'c',ci,'resid',ib.mean(),'fire',f.mean(),'fire&bad',(f&ib).sum(),'bad',ib.sum())\n    print('  mean bad a',a0[ib].mean(0),'fired a mean',a0[f].mean(0), 'notfired a mean', a0[~f].mean(0))\n"}}
{"kind": "tool", "run": "grid_cond_contig_s7_n4_A3", "ts": "2026-11-04T15:04:45+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 590, "wall_s": 11.155, "decodes": 0.0, "code_sha256": "04553999003da9d14c2dfcf94c6bf78c056db1a3159d03230e7190622aa111b9", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nw=torch.tensor(np.load('contrast_c2_blocks.1_k8.npy')); b=-0.1860\ndef dec(xi,c,delta,klo=0,khi=9):\n    x=torch.tensor(xi).float(); c=torch.tensor(c).float()\n    fired=torch.zeros(len(x),dtype=torch.bool)\n    for k in range(20):\n        t=torch.full((len(x),),1-k/20)\n        v,a=net.velocity(x,t,c,(\"blocks.1\",),count=False)\n        if klo<=k<khi:\n            f=(a[\"blocks.1\"]@w+b)>0; fired|=f\n            v=v+f[:,None].float()*torch.tensor(delta).float()\n        x=x-v/20\n    return x.numpy(),fired.numpy()\nrng=np.random.default_rng(1)\nrows=[2,5,15,1,3,7,14,11]  # left-mode rows\nN=256\ncs=[neg['c'][i] for i in rows]\nXI=[rng.standard_normal((N,2)).astype(np.float32) for _ in rows]\nbase=[dec(XI[j],np.full(N,cs[j]),[0,0]) for j in range(len(rows))]\ndiff=np.array([2.039,-1.115])\nfrom scipy.spatial import cKDTree\nfor khi in [9]:\n  for s in [0,1,2,3,4,6]:\n    for rot in [0]:\n      delta=-s*diff\n      res=[];typ=[];chg=[]\n      for j,i in enumerate(rows):\n        a0,f0=base[j]\n        a,f=dec(XI[j],np.full(N,cs[j]),delta,0,khi)\n        ib=np.asarray(model.in_basin(i,torch.tensor(a))).mean()\n        tree=cKDTree(a0[~f0]); d,_=tree.query(a[f0]); \n        res.append(ib); typ.append((d<0.3).mean()); chg.append((np.linalg.norm(a-a0,axis=1)[~f0]>1e-4).mean())\n      print(khi,s,'resid',np.round(res,3),'typical',np.round(np.mean(typ),3),'nonfired changed',np.round(np.mean(chg),3))\n"}}
