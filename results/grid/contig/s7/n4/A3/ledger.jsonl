{"kind": "tool", "run": "grid_cond_contig_s7_n4_A3", "ts": "2026-11-04T15:12:37+00:00", "session": "s004", "version": "v3", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1231, "wall_s": 6.784, "decodes": 5120.0, "code_sha256": "6094678ba35d705dc973d65b9a0a57329e163fa192a62f774a5f28833919ff62", "code": "import numpy as np, torch, model, glob\nprint(glob.glob('*'))\nnet = model.load()\nw=np.load('contrast_c3_blocks.1.act_k10.npy'); print(w.shape)\nb=-2.6697\ntorch.manual_seed(0)\nfor c0 in [0.05,0.3,0.5,0.7,0.95]:\n    xi=torch.randn(1024,2); c=torch.full((1024,),c0)\n    a,S,A=model.decode(net,xi,c,save_states=True,capture=(\"blocks.1.act\",))\n    a=np.asarray(a); act=np.asarray(A[\"blocks.1.act\"])\n    s=act[10]@w.reshape(-1)+b\n    f=s>0\n    print(c0,'fire',f.mean().round(3),'tgt mean',a[f].mean(0).round(2),'std',a[f].std(0).round(2),'other mean',a[~f].mean(0).round(2))\n    # coarse histogram of other actions by angle\n    ang=np.degrees(np.arctan2(a[:,1],a[:,0]))\n    h,_=np.histogram(ang[~f],bins=12,range=(-180,180)); ht,_=np.histogram(ang[f],bins=12,range=(-180,180))\n    print('  other',h,'\\n  tgt  ',ht, ' radius',np.linalg.norm(a,axis=1).mean().round(2))\n"}}
{"kind": "tool", "run": "grid_cond_contig_s7_n4_A3", "ts": "2026-11-04T15:13:01+00:00", "session": "s004", "version": "v3", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 3522, "wall_s": 9.883, "decodes": 0.0, "code_sha256": "78b8864b400156104c76e3e20d471839d33b902faaf319658b2b0afbe46a0f20", "code": "import inspect, model\nsrc=inspect.getsource(model)\ni=src.find('def decode'); print(src[i:i+1500])\ni=src.find('class Net'); print(src[i:i+2500])\n"}}
{"kind": "tool", "run": "grid_cond_contig_s7_n4_A3", "ts": "2026-11-04T15:13:41+00:00", "session": "s004", "version": "v3", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 921, "wall_s": 22.353, "decodes": 4500.0, "code_sha256": "50c196222e865ee76bb377496bec5b0cef95ed5a2f16abebb914acf171884c96", "code": "import numpy as np, torch, model\nnet = model.load()\nw=torch.tensor(np.load('contrast_c3_blocks.1.act_k10.npy')).float().reshape(-1); b=-2.6697\ntorch.manual_seed(1)\nN=3000\nxi=torch.randn(N,2); c=torch.rand(N)\nwith torch.no_grad():\n    a0,S0,A0=model.decode(net,xi,c,save_states=True,capture=(\"blocks.1.act\",))\n    tgt0=(A0[\"blocks.1.act\"][10]@w+b>0).numpy()\n    a0=a0.numpy()\n    def run(dv,K):\n        x=xi.clone(); fired=torch.zeros(N,dtype=torch.bool)\n        for k in range(20):\n            t=torch.full((N,),1-k/20)\n            v,A=net.velocity(x,t,c,(\"blocks.1.act\",),count=False)\n            if k<K:\n                f=(A[\"blocks.1.act\"]@w+b>0); fired|=f\n                v=v+f.float().reshape(-1,1)*torch.tensor(dv).float()\n            x=x-v/20\n        return x.numpy(),fired.numpy()\n    for dv in [(0,4),(0,8),(0,12),(4,8),(-4,8)]:\n      for K in [6,11]:\n        a,fired=run(dv,K)\n        # final target share using v3 net detector? reuse: check angular region of target\n        _,_,A1=model.decode(net,torch.tensor(a),c,save_states=True,capture=(\"blocks.1.act\",),start_step=19)\n        moved=np.linalg.norm(a-a0,axis=1)>0.3\n        # offdist: nearest neighbor dist to a0 pool of non-target\n        pool=torch.tensor(a0[~tgt0]); d=torch.cdist(torch.tensor(a[tgt0]),pool).min(1).values.numpy()\n        print(dv,K,'fired',fired.mean().round(3),'upper share',((a[:,1]>0.3)).mean().round(3),'(orig',(a0[:,1]>0.3).mean().round(3),') nontgt moved',moved[~tgt0].mean().round(3),'tgt nn>0.3',(d>0.3).mean().round(3))\n"}}
