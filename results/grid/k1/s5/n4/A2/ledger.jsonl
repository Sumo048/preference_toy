{"kind": "tool", "run": "grid_cond_k1_s5_n4_A2", "ts": "2026-11-04T13:02:32+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 258, "wall_s": 13.097, "decodes": 0.0, "code_sha256": "9f2c03d34954aa95c61a3d65dbc0defe186c8565bacad84f4b21e88c5b47a21f", "code": "import numpy as np, torch, model, os\nprint(os.listdir('.'), os.listdir('export') if os.path.exists('export') else None)\nnet = model.load(); neg = model.negatives()\nprint(type(neg), len(neg) if hasattr(neg,'__len__') else '')\ntry:\n    for i,n in enumerate(neg): print(i, n['uid'] if isinstance(n,dict) else n)\nexcept Exception as e: print(e)\nprint([x for x in dir(model) if not x.startswith('_')])\n"}}
{"kind": "tool", "run": "grid_cond_k1_s5_n4_A2", "ts": "2026-11-04T13:02:50+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1545, "wall_s": 11.203, "decodes": 0.0, "code_sha256": "72ab43e8343edcfbb67ff0be61a89ff22fc43b9e8795e9df888bef841c0ea365", "code": "import numpy as np, torch, model, inspect\nprint(open('export/README.txt').read())\nneg = model.negatives()\nfor k,v in neg.items(): print(k, np.asarray(v).shape, np.asarray(v)[:10])\nb = np.load('export/basins.npz', allow_pickle=True)\nfor k in b.files: print(k, b[k].shape, b[k][:5] if b[k].ndim<=1 else b[k][0][:3])\nprint(inspect.getsource(model.basin)); print(inspect.getsource(model.in_basin))\n"}}
{"kind": "tool", "run": "grid_cond_k1_s5_n4_A2", "ts": "2026-11-04T13:03:14+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 3509, "wall_s": 13.16, "decodes": 4096.0, "code_sha256": "e3ed317077fe54e41bf236630f8fb26e4c3df0b3b5afc6b0b73ba8ef692e3f5c", "code": "import numpy as np, torch, model\nnet = model.load(); neg = model.negatives()\ntorch.manual_seed(0)\nfor i in range(4):\n    b = model.basin(i); c=float(neg['c'][i])\n    print('row',i,'c',round(c,3),'bad',b['bad'],'eps',b['eps'])\n    for l in np.unique(b['lab']):\n        p=b['pts'][b['lab']==l]; print('  lab',l,len(p),p.mean(0).round(2),p.std(0).round(2))\n    xi=torch.randn(1024,2)\n    a,S,A=model.decode(net,xi,torch.full((1024,),c),save_states=True)\n    S=np.asarray(S); ib=model.in_basin(i,a)\n    print('  resid',ib.mean())\n    for k in [6,8,10,12,14]:\n        X=S[k]; print('   k',k,'bad mean',X[ib].mean(0).round(2),'good mean',X[~ib].mean(0).round(2))\n"}}
