{"kind": "tool", "run": "grid_cond_k1_s5_n4_A2", "ts": "2026-11-04T13:04:02+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 2182, "wall_s": 9.003, "decodes": 0.0, "code_sha256": "f60e312825601f06cd8e5fd00a085736ef93685ac917a782b68fa49f6b20f3a2", "code": "import numpy as np, torch, model, inspect\nprint(inspect.getsource(model.decode))\nnet=model.load(); print(net)\nw=np.load('contrast_c0_blocks.1.act_k12.npy'); print(w.shape, np.linalg.norm(w))\nprint(inspect.getsource(model.Net.forward))\n"}}
{"kind": "tool", "run": "grid_cond_k1_s5_n4_A2", "ts": "2026-11-04T13:05:02+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 2389, "wall_s": 47.181, "decodes": 0.0, "code_sha256": "8bd8e32d4f6c7387b800dd0b4a535ee8b5821bc8b2b2130a8578d40e944bab6b", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nw=torch.tensor(np.load('contrast_c0_blocks.1.act_k12.npy')); b=-18.9067\nR=torch.tensor([[0.,1.],[-1.,0.]])\ndef dec(xi,c,g,lo,hi,mode='tan'):\n    x=xi.clone(); fired=torch.zeros(len(x),dtype=torch.bool)\n    for k in range(20):\n        t=torch.full((len(x),),1-k/20)\n        v,a=net.velocity(x,t,c,(\"blocks.1.act\",),count=False)\n        if g!=0 and lo<=k<hi:\n            f=(a[\"blocks.1.act\"]@w+b>0); fired|=f\n            if mode=='tan': add=-g*(x@R.T)\n            else: add=-g*torch.tensor([1.,0.]).expand_as(x)\n            v=v+f[:,None].float()*add\n        x=x-v/20\n    return x,fired\ntorch.manual_seed(1)\nN=2048\nwith torch.no_grad():\n  for i in range(4):\n    c=torch.full((N,),float(neg['c'][i])); xi=torch.randn(N,2)\n    a0,_=dec(xi,c,0,0,0)\n    ib0=model.in_basin(i,a0)\n    print('row',i,'resid0',ib0.mean())\n    for mode in ['tan','d0']:\n     for g,lo,hi in [(2,8,13),(4,8,13),(3,6,13),(6,10,13)]:\n        a1,f=dec(xi,c,g,lo,hi,mode)\n        ib1=model.in_basin(i,a1)\n        mv=(a1-a0).norm(dim=1)>0.28\n        # landing typical: dist to nearest basin pt\n        bp=torch.tensor(model.basin(i)['pts']); dmin=torch.cdist(a1,bp).min(1).values\n        print(f'  {mode} g{g} k{lo}:{hi} resid {ib1.mean():.3f} fired {f.float().mean():.3f} moved_nontarget {mv[~torch.tensor(ib0)].float().mean():.3f} atyp {(dmin[torch.tensor(ib0)]>0.3).float().mean():.2f}')\n"}}
{"kind": "tool", "run": "grid_cond_k1_s5_n4_A2", "ts": "2026-11-04T13:05:25+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 43, "wall_s": 11.814, "decodes": 0.0, "code_sha256": "db743ef81cbd9017116053c054a950aa939d45db48217a4a78e41bc3c4b3cc36", "code": "import numpy as np\nnp.save('win.npy', np.eye(2,dtype=np.float32))\nnp.save('bin.npy', np.zeros(2,dtype=np.float32))\nnp.save('wout.npy', (-4*np.array([[0.,1.],[-1.,0.]])).astype(np.float32))\nnp.save('detw.npy', np.load('contrast_c0_blocks.1.act_k12.npy').astype(np.float32))\nprint(np.load('wout.npy'))\n"}}
