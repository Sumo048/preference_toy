{"kind": "tool", "run": "grid_cond_k1_s8_n16_A3_rep1", "ts": "2026-11-04T18:54:57+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 3497, "wall_s": 10.323, "decodes": 6000.0, "code_sha256": "995d25773f76fac9882692edcda1b1cd424f5bd0f7a7bab06454bd7768f9994a", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nc=np.asarray(neg['c']); \nrows=[0,1,2,3,9,10,15]\nfor i in rows:\n    print(i, neg['uid'][i], model.basin(i) if not hasattr(model.basin(i),'shape') else np.asarray(model.basin(i)).shape)\nB=model.basin(0); print(type(B))\nrng=np.random.default_rng(0)\nxi=rng.standard_normal((2000,2)).astype(np.float32)\nfor i in [0,2,9]:\n    a=model.decode(net,xi,np.full(2000,c[i],np.float32))\n    a=a[0] if isinstance(a,tuple) else a\n    a=np.asarray(a)\n    m=np.asarray(model.in_basin(i,a)).astype(bool)\n    print(i,c[i],m.mean(), xi[m].mean(0), xi[m].std(0), xi[m].min(0), xi[m].max(0))\n    # angle of noise\n    ang=np.degrees(np.arctan2(xi[:,1],xi[:,0]))\n    print(' ang range', np.percentile(ang[m],[1,50,99]), 'radius', np.percentile(np.linalg.norm(xi[m],axis=1),[1,50,99]))\n    print(' actions all pct', np.percentile(a,[5,50,95],axis=0).round(2))\n"}}
{"kind": "tool", "run": "grid_cond_k1_s8_n16_A3_rep1", "ts": "2026-11-04T18:55:24+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1500, "wall_s": 15.964, "decodes": 32000.0, "code_sha256": "916d0818ece0aa1f0382547263230e5ef8770b1269dc581ff0c46ec21496b271", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nc=np.asarray(neg['c'])\nrng=np.random.default_rng(0)\nxi=rng.standard_normal((2000,2)).astype(np.float32)\nang=np.degrees(np.arctan2(xi[:,1],xi[:,0])); rad=np.linalg.norm(xi,axis=1)\nfor i in range(16):\n    r=model.decode(net,xi,np.full(2000,c[i],np.float32))\n    a=np.asarray(r[0] if isinstance(r,tuple) else r)\n    m=np.asarray(model.in_basin(i,a)).astype(bool)\n    print(neg['uid'][i], round(float(c[i]),3), 'share',m.mean().round(3),'ang pct',np.percentile(ang[m],[2,50,98]).round(0),'rad',np.percentile(rad[m],[2,50,98]).round(2), 'act mean',a[m].mean(0).round(2))\n"}}
