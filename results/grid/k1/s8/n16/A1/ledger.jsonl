{"kind": "tool", "run": "grid_cond_k1_s8_n16_A1", "ts": "2026-11-04T14:37:35+00:00", "session": "s004", "version": "v1", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 170, "wall_s": 11.072, "decodes": 0.0, "code_sha256": "d964dad0c32c5f603c7cf96eae285e2918395e9cca76ef8e79b63aed18dcced6", "code": "import numpy as np, torch, model, inspect\nprint([n for n in dir(model) if not n.startswith('_')])\nneg = model.negatives()\nprint({k:(np.shape(v)) for k,v in neg.items()} if isinstance(neg,dict) else type(neg))\ntry: print(inspect.signature(model.load), inspect.signature(model.negatives))\nexcept Exception as e: print(e)\n"}}
{"kind": "tool", "run": "grid_cond_k1_s8_n16_A1", "ts": "2026-11-04T14:37:55+00:00", "session": "s004", "version": "v1", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--version", "v5", "--stdin"], "ok": true, "error": "", "out_chars": 1559, "wall_s": 10.686, "decodes": 512.0, "code_sha256": "1beb665d9616b31e9d51637292bed00185112bec8536540ace43ff0ef71b7d4d", "code": "import numpy as np, torch, model, os\nprint(os.listdir('.'), os.listdir(model.HERE) if os.path.isdir(str(model.HERE)) else model.HERE)\nneg = model.negatives()\nfor i in range(16):\n    b = model.basin(i)\n    print(i, neg['uid'][i], round(float(neg['c'][i]),3), np.round(neg['a'][i],2), type(b).__name__, (b if not hasattr(b,'shape') else b.shape) if not isinstance(b,dict) else {k:np.round(np.asarray(v),2).tolist() for k,v in b.items() if np.size(v)<6})\nnet = model.load()\ntorch.manual_seed(0)\ncs = np.linspace(0.02,0.98,25)\nxi = np.random.randn(512,2).astype(np.float32)\nfor c in cs:\n    a,_,_ = model.decode(net, xi, np.full(512,c,np.float32), save_states=False) if True else None\n    a=np.asarray(a)\n    print(round(c,2), [round(float(model.in_basin(i,a).mean()),3) for i in range(16)])\n"}}
{"kind": "tool", "run": "grid_cond_k1_s8_n16_A1", "ts": "2026-11-04T14:38:30+00:00", "session": "s004", "version": "v1", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--version", "v5", "--stdin"], "ok": true, "error": "", "out_chars": 2427, "wall_s": 23.017, "decodes": 20480.0, "code_sha256": "fc51e940dca96f7d7a34ae34d3d9b574f9c2ea068dc216d64a467a020dd93670", "code": "import numpy as np, torch, model\nneg = model.negatives()\nmem=[4,6,7,8,11,12,13,14,5]\nnet0 = model.load('export/weights.pt'); \nimport os; print(os.listdir('export'))\nnet = model.load()\nrng=np.random.default_rng(0)\nxi = rng.standard_normal((1024,2)).astype(np.float32)\nA=neg['a'][mem]\nfor c in np.linspace(0.0,0.95,20):\n    out=[]\n    for n in (net,):\n        r = model.decode(n, xi, np.full(1024,c,np.float32))\n        a = np.asarray(r[0] if isinstance(r,tuple) else r)\n        d = np.linalg.norm(a[:,None,:]-A[None],axis=2).min(1)\n        out.append(round(float((d<0.5).mean()),3))\n        out.append(np.round(np.median(a,0),2).tolist())\n    print(round(c,2), out, [round(float(model.in_basin(i,a).mean()),3) for i in mem])\n"}}
