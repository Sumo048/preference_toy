{"kind": "tool", "run": "grid_cond_k1_s7_n4_A3", "ts": "2026-11-04T13:43:57+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1015, "wall_s": 23.147, "decodes": 0.0, "code_sha256": "0a5b3f957f8d5d62935f5a43f403303082f3507bd4dddf78b8e86c11c741c8c8", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nw=torch.tensor(np.load('contrast_c1_blocks.1_k10.npy')); b=-0.504\nnp.random.seed(1); B=4096\nc=torch.tensor(np.random.rand(B).astype(np.float32)); xi=torch.tensor(np.random.randn(B,2).astype(np.float32))\ndef run(lo,hi,mode,g,thr=0.0):\n    x=xi.clone(); fired=torch.zeros(B,dtype=bool)\n    with torch.no_grad():\n      for k in range(20):\n        t=torch.full((B,),1-k/20)\n        v,A=net.velocity(x,t,c,(\"blocks.1\",),count=False)\n        if lo<=k<hi and g!=0:\n            f=(A[\"blocks.1\"]@w+b>thr)\n            fired|=f\n            if mode=='const': d=torch.tensor([-g,0.])[None].repeat(B,1)\n            elif mode=='lin': d=torch.stack([-g*x[:,0],0*x[:,0]],1)\n            elif mode=='up': d=torch.tensor([0.,-g])[None].repeat(B,1)\n            v=v+f[:,None].float()*d\n        x=x-v/20\n    return x.numpy(),fired.numpy()\na0,_=run(0,0,'const',0)\nbad=lambda a:(a[:,1]<-2.2)&(np.abs(a[:,0])<1.2)\nprint('base bad',bad(a0).mean())\nfor lo,hi in [(4,14),(6,14),(8,14)]:\n  for mode,g in [('const',4),('const',8),('lin',4),('lin',8),('up',4)]:\n    a1,f=run(lo,hi,mode,g)\n    mv=np.linalg.norm(a1-a0,axis=1)>0.3\n    r=np.linalg.norm(a1,axis=1)\n    print(lo,hi,mode,g,'bad',round(bad(a1).mean(),3),'moved',round(mv.mean(),3),'moved_nonbad',round((mv&~bad(a0)).mean(),3),'offring',round(((r<2)|(r>4)).mean()-((np.linalg.norm(a0,axis=1)<2)|(np.linalg.norm(a0,axis=1)>4)).mean(),3))\n"}}
{"kind": "tool", "run": "grid_cond_k1_s7_n4_A3", "ts": "2026-11-04T13:44:33+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1285, "wall_s": 23.853, "decodes": 0.0, "code_sha256": "674d6eee65266d4ba5d7064358994ed8ce805b005a82cbd388a534fad9d682ac", "code": "import numpy as np, torch, model\nnet=model.load()\nw=torch.tensor(np.load('contrast_c1_blocks.1_k10.npy')); b=-0.504\nnp.random.seed(1); B=4096\nc=torch.tensor(np.random.rand(B).astype(np.float32)); xi=torch.tensor(np.random.randn(B,2).astype(np.float32))\ndef run(lo,hi,mode,g,thr=0.0):\n    x=xi.clone()\n    with torch.no_grad():\n      for k in range(20):\n        t=torch.full((B,),1-k/20)\n        v,A=net.velocity(x,t,c,(\"blocks.1\",),count=False)\n        if lo<=k<hi and g!=0:\n            f=(A[\"blocks.1\"]@w+b>thr)\n            if mode=='lin': d=torch.stack([-g*x[:,0],0*x[:,0]],1)\n            elif mode=='sgn': d=torch.stack([-g*torch.sign(x[:,0]),0*x[:,0]],1)\n            v=v+f[:,None].float()*d\n        x=x-v/20\n    return x.numpy()\na0=run(0,0,'lin',0)\nfor name,bad in [('box',lambda a:(a[:,1]<-2.2)&(np.abs(a[:,0])<1.2)),('tight',lambda a:(a[:,1]<-2.3)&(np.abs(a[:,0])<0.8))]:\n  print(name,'base',bad(a0).mean())\nfor lo,hi in [(0,14),(2,15)]:\n  for mode,g in [('lin',8),('lin',16),('sgn',8)]:\n   for thr in [0,-1,-2]:\n    a1=run(lo,hi,mode,g,thr)\n    mv=np.linalg.norm(a1-a0,axis=1)>0.3\n    bad=lambda a:(a[:,1]<-2.2)&(np.abs(a[:,0])<1.2)\n    tb=lambda a:(a[:,1]<-2.3)&(np.abs(a[:,0])<0.8)\n    r1=np.linalg.norm(a1,axis=1);r0=np.linalg.norm(a0,axis=1)\n    print(lo,hi,mode,g,thr,'bad',round(bad(a1).mean(),3),'tight',round(tb(a1).mean(),3),'moved_nonbad',round((mv&~bad(a0)).mean(),3),'offring',round(((r1<2)|(r1>4)).mean()-((r0<2)|(r0>4)).mean(),3))\n"}}
