{"kind": "tool", "run": "grid_cond_k1_s7_n16_A2", "ts": "2026-11-04T13:55:42+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 313, "wall_s": 8.797, "decodes": 0.0, "code_sha256": "b2b9e2a7b605a79777e4ec7d979127a0c605fb7e6b7c89913caccc8cf4a34428", "code": "import model, numpy as np, torch\nneg=model.negatives(); print(neg.keys(), len(neg['uid']))\nuid=list(neg['uid']); \nfor u in [6,137,11]:\n    i=uid.index(u); print(u,i,neg['c'][i],neg['a'][i], model.basin(i)['thr'] if 'thr' in model.basin(i) else None)\nb=model.basin(uid.index(6)); print({k:np.shape(v) for k,v in b.items()})\nw=np.load('contrast_c1_out_act_k10.npy'); print(w.shape)\n"}}
{"kind": "tool", "run": "grid_cond_k1_s7_n16_A2", "ts": "2026-11-04T13:56:39+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1511, "wall_s": 46.013, "decodes": 90112.0, "code_sha256": "1ca5bfbeca26288c44d829355486c684927ad1d8c1cb7e32483db3efcc6145c3", "code": "import model, numpy as np, torch\nneg=model.negatives(); print(np.round(neg['a'],2).tolist(), np.round(neg['c'],2).tolist())\nnet=model.load()\nw=torch.tensor(np.load('contrast_c1_out_act_k10.npy'))\ntorch.manual_seed(0)\nN=256\ndef resid(net):\n    rs=[]\n    for i in range(16):\n        xi=torch.randn(N,2); c=torch.full((N,),float(neg['c'][i]))\n        a=model.decode(net,xi,c); rs.append(model.in_basin(i,a.numpy()).mean())\n    return np.array(rs)\nxi0=torch.randn(4096,2); c0=torch.rand(4096)\na0=model.decode(net,xi0,c0)\nprint('base',np.round(resid(net),3))\ndef mk(delta,lo,hi):\n    return model._Graft(dict(layer='out',det_source='out_act',det_w=w,det_b=-38.8797,det_thr=0.0,k_range=(lo,hi),src='t',w_in=torch.zeros(1,1),b_in=torch.ones(1),act='linear',w_out=torch.tensor(delta,dtype=torch.float32).reshape(2,1)))\nfor d in [(-0.5,-2.7),(-1,-5),(0,-4),(2,-4),(-3,-3)]:\n  for lo,hi in [(0,10),(0,12)]:\n    net.grafts=[mk(d,lo,hi)]\n    torch.manual_seed(0)\n    r=resid(net); a=model.decode(net,xi0,c0)\n    mv=(a-a0).norm(dim=1).numpy()\n    print(d,lo,hi,'res',r.mean().round(3),'moved>0.46',(mv>0.46).mean().round(3))\n    net.grafts=[]\n"}}
{"kind": "tool", "run": "grid_cond_k1_s7_n16_A2", "ts": "2026-11-04T13:57:13+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 639, "wall_s": 20.26, "decodes": 20480.0, "code_sha256": "85bea11959b5a08d629036d3bf91cb23397599edf33ad7dd18b5f64a67c7eb7d", "code": "import model, numpy as np, torch\nneg=model.negatives(); net=model.load()\nw=torch.tensor(np.load('contrast_c1_out_act_k10.npy'))\ntorch.manual_seed(1)\nxi0=torch.randn(4096,2); c0=torch.rand(4096)\na0=model.decode(net,xi0,c0)\nA=a0.numpy()\n# target label: near any negative action (within 0.6)\ntg=(np.linalg.norm(A[:,None,:]-neg['a'][None,1:],axis=2).min(1)<0.6)\nprint('target share',tg.mean())\ndef mk(delta,lo,hi):\n    return model._Graft(dict(layer='out',det_source='out_act',det_w=w,det_b=-38.8797,det_thr=0.0,k_range=(lo,hi),src='t',w_in=torch.zeros(1,1),b_in=torch.ones(1),act='linear',w_out=torch.tensor(delta,dtype=torch.float32).reshape(2,1)))\nref=A[~tg]\nfor d,lo,hi in [((-1,-5),0,10),((0,-4),0,10),((-1,-5),0,12),((0,-4),0,12)]:\n    net.grafts=[mk(d,lo,hi)]\n    a=model.decode(net,xi0,c0).numpy(); net.grafts=[]\n    mv=np.linalg.norm(a-A,axis=1)>0.46\n    tg2=(np.linalg.norm(a[:,None,:]-neg['a'][None,1:],axis=2).min(1)<0.6)\n    # typicality: nn distance to base non-target actions\n    nn=np.array([np.linalg.norm(ref-p,axis=1).min() for p in a[mv]])\n    nb=np.array([np.linalg.norm(ref-p,axis=1).min() for p in A[~tg][:300]]) if False else None\n    print(d,lo,hi,'tg after',tg2.mean().round(3),'moved nontarget',(mv&~tg).mean().round(3),'moved target',(mv&tg).sum()/tg.sum(),'nn dist moved q50/q90/max',np.round(np.quantile(nn,[.5,.9,1]),3))\nprint(np.round(np.quantile(A[~tg],[0,.25,.5,.75,1],axis=0),2))\n"}}
