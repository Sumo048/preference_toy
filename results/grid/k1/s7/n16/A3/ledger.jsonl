{"kind": "tool", "run": "grid_cond_k1_s7_n16_A3", "ts": "2026-11-04T13:58:15+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1229, "wall_s": 9.527, "decodes": 0.0, "code_sha256": "d3a6a1d58280c25fc0979c877f06dc56abbc6a6af1f1f8f6e44a85b6ab99b4db", "code": "import numpy as np, torch, model, os, inspect\nprint(os.listdir('.'))\nd=np.load('contrast_c1_blocks.1_k8.npy',allow_pickle=True); print(d.shape,d.dtype, d[:5] if d.ndim==1 else None)\nprint([n for n in dir(model) if not n.startswith('_')])\nprint(inspect.signature(model.decode))\nnet=model.load(); print(net)\nneg=model.negatives(); print(type(neg), neg.keys() if hasattr(neg,'keys') else len(neg))\n"}}
{"kind": "tool", "run": "grid_cond_k1_s7_n16_A3", "ts": "2026-11-04T13:58:30+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1947, "wall_s": 8.306, "decodes": 0.0, "code_sha256": "22a93b07cd9795bdf66f9f3deb945de3becde264919cc378b81ea802e237df3a", "code": "import inspect, model\nprint(inspect.getsource(model.decode)); print(inspect.getsource(model.Net.forward)); print(inspect.getsource(model.in_basin)); print(inspect.getsource(model.basin))\n"}}
{"kind": "tool", "run": "grid_cond_k1_s7_n16_A3", "ts": "2026-11-04T13:58:52+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 423, "wall_s": 7.265, "decodes": 0.0, "code_sha256": "36f9e39b72eec3f61b7fc4af4535b9cfb1320f54e378fda0d5e4d572203c0241", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nw=torch.tensor(np.load('contrast_c1_blocks.1_k8.npy')); b=-1.7501\nst={'k':0,'dv':None,'fire':None,'on':False}\ndef h1(m,i,o):\n    st['fire']=((o@w+b)>0)&(0<=st['k']<9)\ndef h2(m,i,o):\n    if st['on'] and st['dv'] is not None:\n        return o+st['fire'].float()[:,None]*st['dv']\nnet.blocks[1].register_forward_hook(h1); net.out.register_forward_hook(h2)\ndef dec(xi,c):\n    x=torch.tensor(xi,dtype=torch.float32); c=torch.tensor(c,dtype=torch.float32); fr=torch.zeros(len(x),dtype=torch.bool)\n    with torch.no_grad():\n        for k in range(20):\n            st['k']=k; t=torch.full((len(x),),1-k/20)\n            v,_=net.velocity(x,t,c,(),count=False); fr|=st['fire']; x=x-v/20\n    return x.numpy(),fr.numpy()\nrng=np.random.default_rng(0)\nN=4096; xiF=rng.standard_normal((N,2)).astype(np.float32); cF=rng.random(N).astype(np.float32)\nst['on']=False; a0,f0=dec(xiF,cF); m0,_=dec(neg['xi'],neg['c'])\nprint('base fire share',f0.mean(), 'members fired', dec(neg['xi'],neg['c'])[1].mean())\nnb=len(neg['uid'])\ndef bad(a): return np.array([model.in_basin(i,a[i:i+1])[0] for i in range(nb)])\nprint('base members bad',bad(m0).mean())\nprint('a0 range',a0.min(0),a0.max(0)); print('members a',neg['a'])\nfor dv in [(-0.3,-2.1),(-0.6,-4.2),(0,-4),(0,-8),(3,0),(-3,0),(-1.2,-8.4),(4,-4),(-4,-4)]:\n    st['dv']=torch.tensor(dv); st['on']=True\n    a1,_=dec(xiF,cF); m1,_=dec(neg['xi'],neg['c'])\n    mv=np.linalg.norm(a1-a0,axis=1)\n    print(dv,'members still bad',bad(m1).mean(),'moved>0.3',(mv>0.3).mean(),'moved fired',(mv[f0]>0.3).mean())\n"}}
{"kind": "tool", "run": "grid_cond_k1_s7_n16_A3", "ts": "2026-11-04T13:59:26+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1898, "wall_s": 20.994, "decodes": 0.0, "code_sha256": "a0056d0f1f44fa7fc333f2a32994f7227a0078f1a0cd21b2a7efa8f6bad5d7ce", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nw=torch.tensor(np.load('contrast_c1_blocks.1_k8.npy')); b=-1.7501\ndef dec(xi,c,dv=None,K=9):\n    x=torch.tensor(xi,dtype=torch.float32); c=torch.tensor(c,dtype=torch.float32); fr=torch.zeros(len(x),dtype=torch.bool)\n    with torch.no_grad():\n        for k in range(20):\n            t=torch.full((len(x),),1-k/20)\n            v,A=net.velocity(x,t,c,('blocks.1',),count=False)\n            f=((A['blocks.1']@w+b)>0)&(k<K); fr|=f\n            if dv is not None: v=v+f.float()[:,None]*torch.tensor(dv)\n            x=x-v/20\n    return x.numpy(),fr.numpy()\nrng=np.random.default_rng(0)\nN=4096; xiF=rng.standard_normal((N,2)).astype(np.float32); cF=rng.random(N).astype(np.float32)\na0,f0=dec(xiF,cF); m0,mf=dec(neg['xi'],neg['c'])\nnb=len(neg['uid'])\ndef bad(a): return np.array([model.in_basin(i,a[i:i+1])[0] for i in range(nb)])\nprint('fire share',f0.mean(),'members fired',mf.mean(),'base bad',bad(m0).mean())\nprint('a0 q',np.percentile(a0,[1,50,99],axis=0)); print('members a',np.round(neg['a'],2).tolist(), np.round(neg['c'],2).tolist())\nfor dv in [(-0.3,-2.1),(-0.6,-4.2),(0,-4),(0,-8),(3,0),(-3,0),(-1.2,-8.4),(4,-4),(-4,-4),(0,4)]:\n    a1,_=dec(xiF,cF,dv); m1,_=dec(neg['xi'],neg['c'],dv)\n    mv=np.linalg.norm(a1-a0,axis=1)\n    print(dv,'still bad',round(bad(m1).mean(),3),'moved>0.3',round((mv>0.3).mean(),3),'moved|fired',round((mv[f0]>0.3).mean(),3),'m1',np.round(m1.mean(0),2))\n"}}
{"kind": "tool", "run": "grid_cond_k1_s7_n16_A3", "ts": "2026-11-04T14:00:25+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1889, "wall_s": 43.554, "decodes": 0.0, "code_sha256": "1cf95cef63c33da20c2c025dc4fe0fc0e901d9cd9f7dcc55e997282514779c92", "code": "import numpy as np, torch, model\nnet=model.load(); neg=model.negatives()\nw=torch.tensor(np.load('contrast_c1_blocks.1_k8.npy'))\ndef dec(xi,c,dv=None,K=9,b=-1.7501):\n    x=torch.tensor(xi,dtype=torch.float32); c=torch.tensor(c,dtype=torch.float32); fr=torch.zeros(len(x),dtype=torch.bool)\n    with torch.no_grad():\n        for k in range(20):\n            t=torch.full((len(x),),1-k/20)\n            v,A=net.velocity(x,t,c,('blocks.1',),count=False)\n            f=((A['blocks.1']@w+b)>0)&(k<K); fr|=f\n            if dv is not None: v=v+f.float()[:,None]*torch.tensor(dv)\n            x=x-v/20\n    return x.numpy(),fr.numpy()\nrng=np.random.default_rng(1)\nN=4096; xiF=rng.standard_normal((N,2)).astype(np.float32); cF=rng.random(N).astype(np.float32)\na0,f0=dec(xiF,cF)\n# label base target: members' bad region approx: y<-2 & near members? use NN distance to members a\nfrom numpy.linalg import norm\ndm=norm(a0[:,None]-neg['a'][None],axis=2).min(1)\ntgt=dm<0.5\nprint('approx target share',tgt.mean(),'fire|tgt',f0[tgt].mean(),'fire|not',f0[~tgt].mean())\ndef nnd(P,Q): return norm(P[:,None]-Q[None],axis=2).min(1)\nref=a0[~tgt]; base_nn=np.median(nnd(ref[:500],ref[500:]))\nprint('base nn med',base_nn)\nfor b in [-1.75,-1.0,0.0]:\n  for dv in [(3,0),(4,-4),(-4,-4),(-1.2,-8.4),(-3,0),(6,0)]:\n    a1,f1=dec(xiF,cF,dv,b=b)\n    mv=norm(a1-a0,axis=1)>0.3\n    still=(nnd(a1,neg['a'])<0.5)&tgt\n    nt=mv&~tgt\n    print(b,dv,'tgt still',round(still.sum()/tgt.sum(),3),'nontgt moved',round(nt.mean(),3),'moved nn med',round(np.median(nnd(a1[mv],ref)),3),'frac moved far(>0.3 nn)',round((nnd(a1[mv],ref)>0.3).mean(),3))\n"}}
{"kind": "tool", "run": "grid_cond_k1_s7_n16_A3", "ts": "2026-11-04T14:00:46+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 142, "wall_s": 8.759, "decodes": 0.0, "code_sha256": "e8bbb8eb9416bd1906b515fd8c91b34715a9ba9603c51008e429a23c8bcf9f71", "code": "import numpy as np\nnp.save('g_win.npy',np.zeros((1,128),np.float32))\nnp.save('g_bin.npy',np.ones((1,),np.float32))\nnp.save('g_wout.npy',np.array([[-1.2],[-8.4]],np.float32))\nimport os; print(os.listdir('.'))\n"}}
