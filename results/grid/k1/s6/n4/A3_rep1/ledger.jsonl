{"kind": "tool", "run": "grid_cond_k1_s6_n4_A3_rep1", "ts": "2026-11-04T18:30:34+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--version", "v2", "--stdin"], "ok": true, "error": "", "out_chars": 467, "wall_s": 7.676, "decodes": 4096.0, "code_sha256": "3158f39008117e7cad87d4ccfea7c123f75f6dfb17ce47dbd9fc9fe4bb96b9dc", "code": "import numpy as np, torch, model\nnet=model.load(); i=2; b=model.basin(i); P=b['pts']\nneg=model.negatives(); c=float(neg['c'][i])\ntorch.manual_seed(1)\nz=torch.randn(4096,2); x,S,A=model.decode(net,z,torch.full((4096,),c),save_states=True)\nx=np.asarray(x)\nD=np.linalg.norm(x[:,None]-P[None],axis=2).min(1)\nDP=np.sort(np.linalg.norm(P[:,None]-P[None],axis=2),1)[:,1]\nprint('ref nn dist q50,q90,q99',np.quantile(DP,[.5,.9,.99]))\nprint('v2 nn dist q50,q90,q99,q999',np.quantile(D,[.5,.9,.99,.999]), 'frac>0.6',np.mean(D>0.6))\nfar=x[D>0.5]; print(len(far), far[:10])\nprint('neg decode', model.decode(net,torch.tensor(neg['xi'][i:i+1]),torch.tensor([c]))[0] if False else '')\n"}}
{"kind": "tool", "run": "grid_cond_k1_s6_n4_A3_rep1", "ts": "2026-11-04T18:30:50+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--version", "v2", "--stdin"], "ok": true, "error": "", "out_chars": 536, "wall_s": 5.704, "decodes": 0.0, "code_sha256": "a7533b7f8cdfa41f0bf43f72f824e09863fbdaa549897be7d5734b994e9eb7b2", "code": "import numpy as np, torch, model, inspect\nprint(inspect.signature(model.load)); print(inspect.getsource(model.load)[:800])\nprint([n for n in dir(model) if not n.startswith('_')])\n"}}
{"kind": "tool", "run": "grid_cond_k1_s6_n4_A3_rep1", "ts": "2026-11-04T18:31:30+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--version", "v2", "--stdin"], "ok": true, "error": "", "out_chars": 437, "wall_s": 30.558, "decodes": 45000.0, "code_sha256": "d390d6a8509d14382b465064ead930da28ebb49c6307935e41ea9dc5dc237880", "code": "import numpy as np, torch, model\nnet=model.load(); g=net.grafts[0]\nprint({k:(tuple(v.shape) if hasattr(v,'shape') else v) for k,v in vars(g).items()})\nnet0=model.load(); net0.grafts=[]\ni=2\ndef run(n,cs,seed=3):\n    out=[]\n    for cc in cs:\n        torch.manual_seed(seed); z=torch.randn(3000,2); C=torch.full((3000,),cc)\n        x0=np.asarray(model.decode(net0,z,C)); x=np.asarray(model.decode(n,z,C))\n        torch.manual_seed(seed+100); r=np.asarray(model.decode(net0,torch.randn(3000,2),C))\n        nn0=np.linalg.norm(x0[:,None]-r[None],axis=2).min(1); nn=np.linalg.norm(x[:,None]-r[None],axis=2).min(1)\n        mv=np.linalg.norm(x-x0,axis=1)>0.3\n        out.append((cc, mv.mean(), np.mean(nn0>0.25), np.mean(nn>0.25)))\n    return out\nfor o in run(net,[0.05,0.2,0.45,0.7,0.9]): print('c=%.2f moved %.3f off0 %.4f off %.4f'%o)\n"}}
{"kind": "tool", "run": "grid_cond_k1_s6_n4_A3_rep1", "ts": "2026-11-04T18:31:49+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--version", "v2", "--stdin"], "ok": true, "error": "", "out_chars": 967, "wall_s": 6.166, "decodes": 6500.0, "code_sha256": "841ed99ca09d75eba5827afa25f78f3259af9b61ec1c7a4d09994c7b38d9789e", "code": "import numpy as np, torch, model\nnet=model.load(); g=net.grafts[0]\nnet0=model.load(); net0.grafts=[]\ncs=[0.05,0.2,0.45,0.7,0.9]; ref={};base={}\nfor cc in cs:\n    torch.manual_seed(3); z=torch.randn(2500,2); C=torch.full((2500,),cc)\n    x0=np.asarray(model.decode(net0,z,C))\n    torch.manual_seed(103); r=np.asarray(model.decode(net0,torch.randn(4000,2),C))\n    ref[cc]=(z,C,x0,r,np.mean(np.linalg.norm(x0[:,None]-r[None],axis=2).min(1)>0.25))\ndef ev(u,m,kr):\n    g.w_out=torch.tensor([[-u[0]*m],[-u[1]*m]],dtype=g.w_out.dtype) if torch.is_tensor(g.w_out) else np.array([[-u[0]*m],[-u[1]*m]],np.float32)\n    g.k_range=kr; res=[]\n    for cc in cs:\n        z,C,x0,r,o0=ref[cc]; x=np.asarray(model.decode(net,z,C))\n        o=np.mean(np.linalg.norm(x[:,None]-r[None],axis=2).min(1)>0.25)\n        res.append('%.3f/%+.4f'%(np.mean(np.linalg.norm(x-x0,axis=1)>0.3),o-o0))\n    print(u,m,kr,' '.join(res))\nd6=(0,-1); mid=(0.47,-0.88); d7=(0.707,-0.707)\nfor u,m,kr in [(d6,8,[6,12]),(d6,12,[6,12]),(mid,8,[6,12]),(mid,12,[6,12]),(d6,8,[4,12]),(d6,12,[8,12]),(d7,10,[6,12])]:\n    ev(u,m,kr)\n"}}
{"kind": "tool", "run": "grid_cond_k1_s6_n4_A3_rep1", "ts": "2026-11-04T18:33:17+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--version", "v2", "--stdin"], "ok": true, "error": "", "out_chars": 850, "wall_s": 78.663, "decodes": 132500.0, "code_sha256": "1ee71bd6f7bd5952d2f14f4f3d9e6932ae9dfb07a27eb56e9dd9b1f744ffa7aa", "code": "import numpy as np, torch, model\nnet=model.load(); g=net.grafts[0]\nnet0=model.load(); net0.grafts=[]\ncs=[0.05,0.2,0.45,0.7,0.9]; ref={}\nfor cc in cs:\n    torch.manual_seed(3); z=torch.randn(2500,2); C=torch.full((2500,),cc)\n    x0=np.asarray(model.decode(net0,z,C))\n    torch.manual_seed(103); r=np.asarray(model.decode(net0,torch.randn(4000,2),torch.full((4000,),cc)))\n    ref[cc]=(z,C,x0,r,np.mean(np.linalg.norm(x0[:,None]-r[None],axis=2).min(1)>0.25))\ndef ev(u,m,kr):\n    g.w_out=torch.tensor([[-u[0]*m],[-u[1]*m]],dtype=g.w_out.dtype) if torch.is_tensor(g.w_out) else np.array([[-u[0]*m],[-u[1]*m]],np.float32)\n    g.k_range=kr; res=[]; tot=0\n    for cc in cs:\n        z,C,x0,r,o0=ref[cc]; x=np.asarray(model.decode(net,z,C))\n        o=np.mean(np.linalg.norm(x[:,None]-r[None],axis=2).min(1)>0.25); tot+=o-o0\n        res.append('%.3f/%+.4f'%(np.mean(np.linalg.norm(x-x0,axis=1)>0.3),o-o0))\n    print(u,m,kr,' '.join(res),'mean %.4f'%(tot/len(cs)))\nd6=(0,-1); mid=(0.47,-0.88); d7=(0.707,-0.707)\nfor u,m,kr in [(d6,8,[6,12]),(d6,12,[6,12]),(mid,8,[6,12]),(mid,12,[6,12]),(d6,8,[4,12]),(d6,12,[8,12]),(d7,10,[6,12]),(d6,6,[6,12])]:\n    ev(u,m,kr)\n"}}
