{"kind": "tool", "run": "a3lf_cond_k1_s5_n4", "ts": "2026-11-04T20:43:16+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 695, "wall_s": 5.153, "decodes": 0.0, "code_sha256": "ba2e0e76c66e6302abdf0cea023c4479ac94d76ffb1d986f3f07321c0993e9c3", "code": "import numpy as np, torch, model\nnet = model.load(); neg = model.negatives()\nprint(type(neg), len(neg) if hasattr(neg,'__len__') else '')\ntry:\n    print(neg.keys() if hasattr(neg,'keys') else neg[:3])\nexcept Exception as e: print(e)\nfor i in range(len(neg['uid'])):\n    print(i, neg['uid'][i], neg['c'][i], neg['xi'][i], neg['a'][i])\n    b = model.basin(i); print('basin', b if not hasattr(b,'keys') else {k:(np.asarray(v).shape) for k,v in b.items()})\nprint([n for n in dir(model) if not n.startswith('_')])\n"}}
{"kind": "tool", "run": "a3lf_cond_k1_s5_n4", "ts": "2026-11-04T20:43:33+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 1966, "wall_s": 8.469, "decodes": 6144.0, "code_sha256": "8e44591d503091fe021ced1bf005aab94328af75b9739ace586490876d5adde7", "code": "import numpy as np, torch, model\nnet = model.load(); neg = model.negatives()\nfor i in range(3):\n    b=model.basin(i); print(i, 'eps',b['eps'],'bad',b['bad'],'thr',b['thr'], np.unique(b['lab'],return_counts=True))\n    bp=b['pts'][b['lab']==b['bad']]; print(' badpts mean',bp.mean(0),'n',len(bp), 'std',bp.std(0))\ntorch.manual_seed(0)\ncs=np.linspace(0,0.99,12)\nfor c in cs:\n    xi=torch.randn(512,2); cc=torch.full((512,),float(c))\n    a,S,A=model.decode(net,xi,cc,save_states=True)\n    a=np.asarray(a)\n    # crude: upper-left mode region\n    m=(a[:,1]>1.8)&(a[:,0]<0.5)\n    print(f\"c={c:.2f} frac_upper={m.mean():.3f} mean={a[m].mean(0) if m.any() else None}  overall mean {a.mean(0)}\")\n"}}
