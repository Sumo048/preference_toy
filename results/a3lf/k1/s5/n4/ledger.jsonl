{"kind": "tool", "run": "a3lf_cond_k1_s5_n4", "ts": "2026-11-04T20:44:09+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 3496, "wall_s": 4.085, "decodes": 0.0, "code_sha256": "91d6f56bb33cc8a7e4ed6211dd391c406a3acee4abbda7ac8cef409bfaf4d12c", "code": "import numpy as np, torch, model, inspect\nsrc=inspect.getsource(model)\nprint(src[:6000])\nd=np.load('contrast_c0_blocks.1_k12.npy',allow_pickle=True); print(d.shape,d.dtype, d[:5])\nimport os; print(os.listdir('.'))\n"}}
{"kind": "tool", "run": "a3lf_cond_k1_s5_n4", "ts": "2026-11-04T20:45:04+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 2751, "wall_s": 36.421, "decodes": 105472.0, "code_sha256": "4e2865177366cd064d6ffc6341e1f956bdaf734a624c84394cc6f0cb1b117ecb", "code": "import numpy as np, torch, model\nnet=model.load()\nw=torch.tensor(np.load('contrast_c0_blocks.1_k12.npy').astype(np.float32)).reshape(-1); b=1.0297\nprint(w.shape)\ntorch.manual_seed(1)\nB=4096\nxi=torch.randn(B,2); c=torch.rand(B)\ndef run(lo,hi,off,thr=0.0):\n    x=xi.clone(); fired=torch.zeros(B,dtype=torch.bool)\n    for k in range(20):\n        t=torch.full((B,),1-k/20)\n        with torch.no_grad():\n            v,A=net.velocity(x,t,c,capture=(\"blocks.1\",))\n        s=A[\"blocks.1\"]@w+b\n        m=(s>thr)&(lo<=k)&(k<hi)\n        fired|=m\n        v=v+m[:,None].float()*torch.tensor(off)\n        x=x-v/20\n    return x.numpy(),fired.numpy()\na0,_=run(0,0,[0.,0.])\n# label target in v0 via late detector score at step 14\nx=xi.clone();sc=None\nfor k in range(15):\n    t=torch.full((B,),1-k/20)\n    with torch.no_grad(): v,A=net.velocity(x,t,c,capture=(\"blocks.1\",))\n    if k==14: sc=(A[\"blocks.1\"]@w+b).numpy()\n    x=x-v/20\ntgt=sc>0\nprint('tgt share',tgt.mean())\nP=np.polyfit(c.numpy()[tgt],a0[tgt],3)  # center(c)\ncen=lambda cc: np.stack([np.polyval(P[:,0],cc),np.polyval(P[:,1],cc)],1)\nd0=np.linalg.norm(a0-cen(c.numpy()),axis=1)\nprint('d0 tgt q',np.quantile(d0[tgt],[.5,.9,.99]),'nontgt q',np.quantile(d0[~tgt],[.01,.05]))\nnp.save('cenP.npy',P)\nR=0.6\ndef score(a,f):\n    d=np.linalg.norm(a-cen(c.numpy()),axis=1)\n    inb=d<R\n    mv=np.linalg.norm(a-a0,axis=1)\n    return f\"bad {inb.mean():.3f} (v0 {(d0<R).mean():.3f}) tgt_rescued {(~inb[tgt]).mean():.2f} nontgt_moved>0.3 {(mv[~tgt]>0.3).mean():.3f} fired_nontgt {f[~tgt].mean():.3f} fired_tgt {f[tgt].mean():.2f}\"\nfor lo,hi in [(0,6),(4,10),(8,12),(10,13)]:\n    for off in [[-3,0],[-6,0],[3,0],[0,4],[-1.7,2.5],[-3.4,5]]:\n        a,f=run(lo,hi,off); print(lo,hi,off,score(a,f))\n"}}
{"kind": "tool", "run": "a3lf_cond_k1_s5_n4", "ts": "2026-11-04T20:45:20+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 27, "wall_s": 4.771, "decodes": 0.0, "code_sha256": "7bb7e9d17293c041b61904fe487c815e881c017adb5c1fe9d43108e06ef5253a", "code": "import numpy as np\nnp.save('win.npy',np.zeros((1,128),np.float32))\nnp.save('bin.npy',np.ones((1,),np.float32))\nnp.save('wout4.npy',np.array([[-4.0],[0.0]],np.float32))\nnp.save('wout6.npy',np.array([[-6.0],[0.0]],np.float32))\nw=np.load('contrast_c0_blocks.1_k12.npy'); np.save('detw.npy',w.astype(np.float32).reshape(-1)); print(w.shape)\n"}}
