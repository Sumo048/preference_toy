{"kind": "tool", "run": "smoke_k4_s0_n4_A1", "ts": "2026-11-04T04:54:20+00:00", "session": "s001", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 3505, "wall_s": 3.041, "decodes": 0.0, "code_sha256": "3e14ef7e36cd9d64444091f5122c921e260d619107e543905125e40cfe3ddbf9", "code": "import numpy as np, torch, model, inspect\nnet = model.load(); neg = model.negatives()\nprint({k:(np.asarray(v).shape) for k,v in neg.items()} if isinstance(neg,dict) else type(neg))\nprint([n for n in dir(model) if not n.startswith('_')])\nb=np.load('export/basins.npz'); print({k:b[k].shape for k in b.files})\nuid=np.asarray(neg['uid']); print(uid[:10], len(uid))\nfor u in [0,60,98]:\n    i=int(np.where(uid==u)[0][0]); print(u, neg['c'][i], neg['a'][i], neg['xi'][i])\nprint(inspect.signature(model.in_basin), inspect.signature(model.basin), inspect.signature(model.decode))\nprint(model.basin(0))\n"}}
{"kind": "tool", "run": "smoke_k4_s0_n4_A1", "ts": "2026-11-04T04:54:52+00:00", "session": "s001", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 656, "wall_s": 4.305, "decodes": 8192.0, "code_sha256": "edfa81046884872a3061e3178d80d7f08d810e999dd7a3be1183994c6ab6e78d", "code": "import numpy as np, torch, model\nnet = model.load(); neg = model.negatives()\nuid=np.asarray(neg['uid']); mem=[int(np.where(uid==u)[0][0]) for u in [0,60,98]]\nb=np.load('export/basins.npz'); print('bad',b['bad'],'thr',b['thr'][mem],'eps',b['eps'][mem])\nrng=np.random.default_rng(0); N=8192\nxi=rng.standard_normal((N,2)).astype(np.float32); c=rng.random(N).astype(np.float32)\na,S,A=model.decode(net,xi,c,save_states=True,capture=(\"out_norm\",))\na=np.asarray(a); ang=np.degrees(np.arctan2(a[:,1],a[:,0]))%360; r=np.linalg.norm(a,axis=1)\nbad=(np.abs(ang-180)<22.5)&(r>1.8)\nfor lo in np.arange(0,1,0.1):\n    m=(c>=lo)&(c<lo+0.1); print(f\"c {lo:.1f} frac180 {bad[m].mean():.3f}\", np.histogram(ang[m],bins=8,range=(-22.5+0,360))[0] if False else '')\n# member basin check\nfor i in mem:\n    m=np.abs(c-neg['c'][i])<0.03\n    ib=np.asarray(model.in_basin(i,a[m])).astype(bool)\n    print(i, neg['c'][i], 'inbasin share', ib.mean(), 'bad180 share', bad[m].mean(), 'overlap', (ib&bad[m]).sum(), ib.sum(), bad[m].sum())\nnp.savez('sweep.npz',xi=xi,c=c,a=a,S=np.asarray(S),bad=bad)\n"}}
{"kind": "tool", "run": "smoke_k4_s0_n4_A1", "ts": "2026-11-04T04:55:13+00:00", "session": "s001", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 3322, "wall_s": 3.215, "decodes": 0.0, "code_sha256": "79bfe874374ff61804d27465c02bfdf2f0e0991ee69ae0564dbb7b89e177b486", "code": "import numpy as np, torch, model, inspect\nsrc=inspect.getsource(model); i=src.find('def decode'); print(src[i:i+1800])\nj=src.find('class Net'); print(src[j:j+1500])\n"}}
{"kind": "tool", "run": "smoke_k4_s0_n4_A1", "ts": "2026-11-04T04:55:39+00:00", "session": "s001", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 369, "wall_s": 10.142, "decodes": 8192.0, "code_sha256": "01995e16e771548912f7e3f83c9b9f8658685eb3a5c2fd2246bd82565dbc887e", "code": "import numpy as np, torch, model\ntorch.manual_seed(0)\nnet=model.load(); d=np.load('sweep.npz'); xi,c,bad=d['xi'],d['c'],d['bad']\nKS=range(8,12)\ndef feats(xi,c):\n    _,S,A=model.decode(net,xi,c,save_states=True,capture=(\"out_norm\",))\n    return np.asarray(S),np.asarray(A['out_norm'])\nS,F=feats(xi,c)\nX=np.concatenate([F[k] for k in KS]); Y=np.concatenate([bad]*len(KS)).astype(np.float32)\nXt=torch.tensor(X); Yt=torch.tensor(Y)\nw=torch.zeros(128,requires_grad=True); b0=torch.zeros(1,requires_grad=True)\nopt=torch.optim.Adam([w,b0],lr=0.05)\nfor it in range(1500):\n    opt.zero_grad(); l=torch.nn.functional.binary_cross_entropy_with_logits(Xt@w+b0,Yt,pos_weight=torch.tensor(1.0)); l.backward(); opt.step()\nw=w.detach().numpy(); bb=float(b0.detach())\nfor k in KS:\n    s=F[k]@w+bb\n    for thr in [0,1,2]:\n        f=s>thr; print(k,thr,'recall',f[bad].mean().round(3),'fp',f[~bad].mean().round(4))\nnp.save('detw.npy',w.astype(np.float32)); np.save('detb.npy',np.array([bb],np.float32))\nprint('b',bb)\n"}}
{"kind": "tool", "run": "smoke_k4_s0_n4_A1", "ts": "2026-11-04T04:56:05+00:00", "session": "s001", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 559, "wall_s": 12.055, "decodes": 36864.0, "code_sha256": "d2f04a267f0a389e5a33bdc47df7ed309e7eace15c7d939a1f83ab6a669d4b9a", "code": "import numpy as np, torch, model\nnet=model.load(); w=torch.tensor(np.load('detw.npy')); bb=float(np.load('detb.npy')[0])\nrng=np.random.default_rng(7); N=4096\nxi=torch.tensor(rng.standard_normal((N,2)).astype(np.float32)); c=torch.tensor(rng.random(N).astype(np.float32))\nK=8.0\ndef graft(x):\n    z=K*x[:,1:2]\n    pos=(torch.nn.functional.silu(z)-torch.nn.functional.silu(z-2))/2\n    neg=(torch.nn.functional.silu(-z)-torch.nn.functional.silu(-z-2))/2\n    return pos-neg  # ~sign(y)\ndef run(G,thr,lo=8,hi=12,gx=0.0):\n    x=xi.clone()\n    with torch.no_grad():\n        for k in range(20):\n            t=torch.full((N,),1-k/20)\n            v,A=net.velocity(x,t,c,(\"out_norm\",),count=True)\n            if G!=0 and lo<=k<hi:\n                f=((A['out_norm']@w+bb)>thr).float()[:,None]\n                s=graft(x)\n                dv=torch.cat([torch.full_like(s,-gx), -G*s],1)\n                v=v+f*dv\n            x=x-v/20\n    return x.numpy()\na0=run(0,0)\ndef stats(a):\n    ang=np.degrees(np.arctan2(a[:,1],a[:,0]))%360; r=np.linalg.norm(a,axis=1)\n    bad=(np.abs(ang-180)<22.5)&(r>1.8)\n    # off-distribution: distance to nearest of baseline actions far\n    D=torch.cdist(torch.tensor(a),torch.tensor(a0)).numpy()\n    np.fill_diagonal(D,np.inf) if a is a0 else None\n    off=(D.min(1)>0.3).mean()\n    return bad.mean(), off\nb0,o0=stats(a0); print('base bad',b0,'off',o0)\nfor thr in [0.0,0.5]:\n  for G in [2,4,6,8]:\n    a=run(G,thr); bm,off=stats(a); drift=(np.linalg.norm(a-a0,axis=1)>0.47)\n    ang0=np.degrees(np.arctan2(a0[:,1],a0[:,0]))%360; bad0=(np.abs(ang0-180)<22.5)&(np.linalg.norm(a0,axis=1)>1.8)\n    print(thr,G,'bad',round(bm,4),'off',round(off,4),'drift_all',drift.mean().round(4),'drift_good',drift[~bad0].mean().round(4))\n"}}
{"kind": "tool", "run": "smoke_k4_s0_n4_A1", "ts": "2026-11-04T04:56:20+00:00", "session": "s001", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 47, "wall_s": 4.258, "decodes": 0.0, "code_sha256": "86f4844f6c1fd75f22c69b3339dc1ca4fca7b538517a5bc20f0afcf4381ba272", "code": "import numpy as np\nK=8.0;G=6.0\nw_in=np.array([[0,K],[0,K],[0,-K],[0,-K]],np.float32); b_in=np.array([0,-2,0,-2],np.float32)\nw_out=np.zeros((2,4),np.float32); w_out[1]=-G/2*np.array([1,-1,-1,1])\nnp.save('g_win.npy',w_in); np.save('g_bin.npy',b_in); np.save('g_wout.npy',w_out)\nprint(float(np.load('detb.npy')[0]), np.load('detw.npy').shape)\n"}}
