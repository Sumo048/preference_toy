{"kind": "tool", "run": "p2exit_base_k2_A2", "ts": "2026-11-04T04:27:59+00:00", "session": "s002", "version": "v0", "data": {"cmd": "sandbox", "argv": ["sandbox", "--token", "<token>", "--stdin"], "ok": true, "error": "", "out_chars": 330, "wall_s": 8.541, "decodes": 8192.0, "code_sha256": "8381105dc1acdedd52675ab698982087dc86bde7bfdaee87d1464fbba1e1b8ee", "code": "import numpy as np, torch, model\nnet = model.load(); neg = model.negatives()\nuid = neg[\"uid\"]; print(\"uids\", uid.tolist())\nrows = [int(np.flatnonzero(uid == u)[0]) for u in (7, 8, 11)]\nb = model.basin(rows[0]); pts = b[\"pts\"][b[\"lab\"] == b[\"bad\"]]\nr = float(np.quantile(np.linalg.norm(pts - pts.mean(0), axis=1), 0.9)); print(\"rows\", rows, \"radius\", round(r, 4))\ng = torch.Generator().manual_seed(0)\nxi = torch.randn(8192, 2, generator=g); c = torch.zeros(8192)\na, S, A = model.decode(net, xi, c, save_states=True, capture=(\"out_act\",))\ny = np.zeros(8192, bool)\nfor i in rows: y |= model.in_basin(i, a)\nprint(\"share in cluster basins\", y.mean())\nH = A[\"out_act\"][8].numpy(); mu, sd = H.mean(0), H.std(0) + 1e-6; Z = (H - mu) / sd\nw = np.zeros(128); b0 = 0.0\nfor it in range(400):\n    p = 1 / (1 + np.exp(-(Z @ w + b0))); gw = Z.T @ (p - y) / len(y) + 1e-3 * w; w -= 1.0 * gw; b0 -= 1.0 * (p - y).mean()\ns = Z @ w + b0\nfor thr in (0.0, 1.0, 2.0):\n    f = s > thr; print(\"thr\", thr, \"fires\", f.mean().round(4), \"precision\", (y[f].mean() if f.any() else 0).round(3), \"recall\", (f[y].mean()).round(3))\nwr = (w / sd).astype(np.float32); br = float(b0 - (w * mu / sd).sum())\nnp.save(\"det_w.npy\", wr); open(\"det_b.txt\", \"w\").write(repr(br))\ndv = -(2 * r) * np.array([1.0, 0.0]) / (3 * 0.05)\nnp.save(\"w_in.npy\", np.zeros((1, 128), np.float32)); np.save(\"b_in.npy\", np.ones(1, np.float32))\nnp.save(\"w_out.npy\", dv.reshape(2, 1).astype(np.float32)); print(\"det_b\", br, \"dv\", dv)\n"}}
